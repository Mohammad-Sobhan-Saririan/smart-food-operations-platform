# Core
NODE_ENV=development
PORT=5001
APP_NAME=Smart Food Operations
FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
DB_PATH=./smart-food-operations.sqlite

# Authentication
AUTH_MODE=local
# Demo placeholders are accepted only outside production. Replace them before deployment.
JWT_SECRET=local-demo-only-jwt-secret-change-me-1234567890
DELIVERY_LOCK_SECRET=local-demo-only-lock-secret-change-me-123456789

# Optional LDAP / Active Directory (used only when AUTH_MODE=ldap)
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_DOMAIN=

# Optional notifications
NOTIFICATIONS_PROVIDER=none
# Used only when NOTIFICATIONS_PROVIDER=firebase
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional LLM-assisted analytics
LLM_ENABLED=false
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_HTTP_REFERER=
